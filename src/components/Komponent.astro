---
import { BodyLong, Heading } from '@navikt/ds-react';
import Piktogram from '../icons/Piktogram.astro';
import styles from '../styles/Komponent.module.css';
import LinkCard from './link-card/LinkCard.astro';

const { heading, description } = Astro.props;
---

<LinkCard id="linkCard">
    <div class={styles.ikonOgTekstContainer}>
        <Piktogram aria-hidden="true" />
        <div>
            <Heading level="3" size="small" className={styles.heading}>
                {heading}
            </Heading>
            <BodyLong size="medium" className={styles.detail}>
                {description}
            </BodyLong>
        </div>
    </div>
</LinkCard>

<script>
    import { logCardClick } from '@src/utils/analytics.ts';
    const linkCard = document.querySelector<HTMLAnchorElement>('.ungdomsprogramytelse-innsyn-mikrofrontend-ssr a');
    linkCard?.addEventListener('click', () => logCardClick(linkCard.href));
</script>
