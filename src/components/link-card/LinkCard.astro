---
import { LINK_CARD_URL, SERVICE_NAME } from 'astro:env/server';
import { logger } from '@src/utils/logger.ts';
import styles from '../../styles/LinkCard.module.css';

logger.info(`${SERVICE_NAME} ble lastet inn med lenke til ${LINK_CARD_URL}.`);
---

<a id={styles.linkcard} class="navds-panel navds-link-panel" href={LINK_CARD_URL}>
    <div class="navds-link-panel__content">
        <slot />
    </div>
    <svg
        id={styles.linkcardChevron}
        class="navds-link-panel__chevron"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" fill-rule="evenodd"></path>
    </svg>
</a>
